{
  "name": "macro-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/copy-404.mjs",
    "preview": "wrangler pages dev dist --d1 DB=macro_tracker",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply macro_tracker --local",
    "foods:foundation:sql": "node scripts/generate-foundation-food-inserts.mjs FoodData_Central_foundation_food_json_2026-04-30.json --out foundation-food-inserts.sql"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260501.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
